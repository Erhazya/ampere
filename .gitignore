# Local working notes, kept out of the public repository
BRIEF.md
PROMPTS.md
TRANSFERT.md

# Python: virtual environment, bytecode and tool caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node: dependencies and build output of the dashboard
node_modules/
web/dist/

# Data, never committed: the raw layer is the only copy of what the sources sent, kept by
# the platform's backups; the rest is rebuilt from it (ADR 022). Anchored at the root, so
# that the src/ampere/data package is not ignored.
/data/

# Secrets: only .env.example is committed
.env

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
